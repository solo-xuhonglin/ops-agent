# ===== 部署环境变量模板 =====
# 复制为 .env 后修改：cp .env.example .env
# 服务器 IP（用于 CORS 与反向代理，按需修改）
SERVER_IP=118.195.145.247

# ===== 数据库（PostgreSQL + pgvector）=====
DB_USERNAME=opsagent
DB_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=opsagent

# ===== JWT（请用 openssl rand -base64 48 生成至少 32 位随机串替换）=====
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_32_chars

# ===== CORS（前端实际访问地址，逗号分隔）=====
CORS_ALLOWED_ORIGINS=http://118.195.145.247,http://localhost:8080

# ===== 端口映射（按需修改宿主机端口）=====
POSTGRES_PORT=5432
ADMIN_PORT=8080
HTTP_PORT=80

# ===== 初始化开关 =====
# 是否写入种子数据（权限/角色/用户：admin、user），默认 true
# 设为 false 时启动不初始化任何账号，适用于已有数据的环境
APP_INIT_ENABLED=true

# ===== 部署脚本变量（由 deploy.sh 读取，不传给 compose）=====
# 仓库地址（已默认值，可在部署时 export REPO_URL=... 覆盖）
# REPO_URL=https://github.com/solo-xuhonglin/ops-agent.git
# 服务器上的项目目录
# PROJECT_DIR=/opt/ops-agent
# 部署分支
# BRANCH=main
