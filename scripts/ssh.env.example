# ops-agent 运维脚本的 SSH 连接凭据模板。
#
# 使用方式（推荐放用户主目录，避免项目目录内文件被清理/同步覆盖）：
#   mkdir -p ~/.ops-agent && cp scripts/ssh.env.example ~/.ops-agent/ssh.env
#   然后填入真实值（scripts/ssh.env 仍作为兼容兜底）
#
# ssh.env 已被 .gitignore 忽略，切勿提交。
# scripts/*.py 通过 scripts/_conn.py 读取这份配置（优先 ~/.ops-agent/，其次 scripts/）。
# 任何一项也可用同名环境变量覆盖，环境变量优先级更高。
# 全部部署凭据（DB/JWT/MinIO/DeepSeek）可维护在 ~/.ops-agent/credentials.env（.env 格式，与服务器对齐）。

# 必填：服务器 IP 或域名
REMOTE_HOST=
# 必填：SSH 登录密码（scripts/*.py 需要密码）
SSHPASS=

# 可选：默认 root
REMOTE_USER=root
# 可选：默认 22
REMOTE_PORT=22
# 可选：服务器上的项目目录，默认 /opt/ops-agent
REMOTE_DIR=/opt/ops-agent
